{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C#: Current file",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "C#: Build current file",
      "program": "${env:TEMP}/dotnet/runfile/${fileBasenameNoExtension}.dll",
      "args": ["-l t"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal"
    },
    {
      "name": "C#: Current file with arguments",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "C#: Build current file",
      "program": "${env:TEMP}/dotnet/runfile/${fileBasenameNoExtension}.dll",
      "args": "${input:debugArgs}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal"
    },
    {
      "name": "C#: Version.cs file",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/Version.cs"
    },
    {
      "name": "Python: Current file with arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}"
    }
  ],
  "inputs": [
    {
      "id": "debugArgs",
      "type": "promptString",
      "description": "Debug arguments",
      "default": ""
    }
  ]
}
